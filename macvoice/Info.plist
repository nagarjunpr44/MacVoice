<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>local.macvoice</string>
  <key>CFBundleName</key><string>macvoice</string>
  <key>NSMicrophoneUsageDescription</key><string>macvoice listens for your spoken commands.</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>macvoice turns your speech into text on this Mac.</string>
  <!-- Without this key macOS DENIES Apple Events outright instead of prompting, so browser tabs
       stay invisible. Same trap as the speech key, but it fails silently rather than crashing. -->
  <key>NSAppleEventsUsageDescription</key><string>macvoice reads your open browser tabs so you can switch to them by voice, and opens searches for you.</string>
</dict>
</plist>
